name: My Custom Windows Build
on:
  on:
  workflow_call:
    inputs:
      upload-tag:
        description: 'Tag to upload the artifacts'
        required: false
        default: 'nightly'
        type: string
      upload-artifact:
        description: 'Upload artifact'
        required: false
        default: true
        type: boolean
        shell: bash
        run: |
          pip install -r requirements.txt 2>/dev/null || true
          python3 build.py --flutter --hwcodec --skip-portable-pack
      - name: Upload
        uses: actions/upload-artifact@v4
        with:
          name: Roger-Support-Windows
          path: flutter/build/windows/x64/runner/Release/
